{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "peiravela/suite-catalog-v2",
  "title": "SuiteCatalog",
  "description": "Catalog v2 document structure contract. This schema freezes the catalog STRUCTURE fields (api_version, kind, scenarios, perturbations, controls, seeds). Control-adapter observation behavior is not frozen here; the draft LOIMOS-3 v2 catalog must be validated against real provider flows before it is pinned by an ExperimentSourceBinding. Immutable once published (index.json compatibility: published_schema_is_mutable=false).",
  "type": "object",
  "required": ["api_version", "kind", "id", "version", "owner", "world_contract", "scenarios"],
  "properties": {
    "api_version": { "const": "peiravela/v2" },
    "kind": { "const": "SuiteCatalog" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "world_contract": {
      "type": "object",
      "required": ["namespace", "requires"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "object",
          "required": ["network_isolation", "egress_control", "identity_scoping", "disposable"],
          "properties": {
            "network_isolation": { "type": "boolean" },
            "egress_control": { "type": "boolean" },
            "identity_scoping": { "type": "boolean" },
            "disposable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "family": { "type": "string" },
          "title": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["operation", "target"],
              "properties": {
                "operation": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "perturbations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "scenario"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "mutations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["patch"],
              "properties": {
                "patch": {
                  "type": "object",
                  "required": ["id", "content"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "content": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "adapter"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "selectors": { "type": "array", "items": { "type": "string" } },
          "options": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "seeds": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    }
  },
  "additionalProperties": false
}
