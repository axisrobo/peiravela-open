{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peiravela.axisrobo.example/schemas/scenario-v1.json",
  "title": "PEIRAVELA Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "world_ref", "actors", "steps", "provenance"],
  "properties": {
    "api_version": {"const": "peiravela/v1"},
    "kind": {"const": "Scenario"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "world_ref": {"type": "string", "minLength": 1},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind"]}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "actor", "op"]}},
    "perturbations": {"type": "array", "items": {"type": "object"}},
    "invariants": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_label", "source_digest"],
      "properties": {
        "state_label": {"enum": ["observed", "replayed", "synthetic", "simulated", "predicted", "derived"]},
        "source_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
