{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peiravela.axisrobo.example/schemas/jacob-profile-v1.json",
  "title": "PEIRAVELA JACoB Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "id", "version", "quality_dimensions", "evaluation_boundary", "provenance"],
  "properties": {
    "api_version": {"const": "peiravela/v1"},
    "kind": {"const": "JACoBProfile"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "quality_dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
    "evaluation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_evaluator_required", "judgments_owned_by_peiravela"],
      "properties": {
        "external_evaluator_required": {"const": true},
        "judgments_owned_by_peiravela": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_label", "source_digest"],
      "properties": {
        "state_label": {"enum": ["observed", "replayed", "synthetic", "simulated", "predicted", "derived"]},
        "source_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "categories"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "active", "frozen", "deprecated"]},
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "suite_refs"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["planned", "active", "frozen", "deprecated"]},
              "suite_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
