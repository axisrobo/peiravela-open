{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peiravela.axisrobo.example/schemas/evidence-package-v1.json",
  "title": "PEIRAVELA EvidencePackage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "manifest_version", "attempt_id", "created_at", "artifacts"],
  "properties": {
    "api_version": {"const": "peiravela/v1"},
    "kind": {"const": "EvidencePackage"},
    "manifest_version": {"const": "1.0.0"},
    "attempt_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "digest", "path"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
